# Copy to .env and fill in real values. .env is git-ignored; never commit it.

# Either set DATABASE_URL (hosted Postgres such as Neon) or the DB_* values below.
# DATABASE_URL=postgres://user:password@host/attendly?sslmode=require

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=attendly
DB_SSLMODE=disable

# Falls back to PORT (set by hosts like Render), then 8080.
SERVER_PORT=8080

# Long random string, e.g. the output of: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=168

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173

# Set to false once your own account exists, so strangers can't sign up.
ALLOW_REGISTRATION=true
